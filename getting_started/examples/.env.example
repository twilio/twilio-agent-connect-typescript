# Twilio Agent Connect - Environment Variables
# Copy this file to .env and update with your values

# Required
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: additional senders (comma-separated allowlist). The singular var above is the default sender.
# TWILIO_PHONE_NUMBERS=+15551234567,+14440000000

# Optional - Voice Channel (domain only, without https:// prefix)
TWILIO_VOICE_PUBLIC_DOMAIN=your-domain.ngrok.app

# Optional - WhatsApp Channel (include whatsapp: prefix, e.g., whatsapp:+15551234567)
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx
# Optional: additional WhatsApp senders (comma-separated allowlist). The singular var above is the default sender.
# TWILIO_WHATSAPP_NUMBERS=whatsapp:+1xxxxxxxxxx,whatsapp:+1yyyyyyyyyy

# Optional - Twilio Region (routes API requests to a specific region)
# TWILIO_REGION=

# Optional - Chat Example
TWILIO_CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - RCS Channel (RCS Sender ID)
# Required for examples/rcs and RCS outbound
TWILIO_RCS_SENDER_ID=rcs:your_sender_id
# Optional: additional RCS senders (comma-separated allowlist). The singular var above is the default sender.
# TWILIO_RCS_SENDER_IDS=rcs:your_sender_id,rcs:your_other_sender_id

# Optional - OpenAI Example
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - Handoff Example (Studio Flow SID used by createStudioHandoffTool)
TWILIO_STUDIO_HANDOFF_FLOW_SID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
